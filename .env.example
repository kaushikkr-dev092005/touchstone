# Sandbox only. Set in your shell; this file is documentation, not auto-loaded.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Required for hosted checkout and for keys linked to multiple accounts.
AIRWALLEX_ACCOUNT_ID=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CHECKOUT_SUCCESS_URL=https://www.airwallex.com
# Optional llama.cpp/OpenAI-compatible local server. No automatic model downloads.
LOCAL_INFERENCE_URL=http://127.0.0.1:8080/v1/chat/completions
LOCAL_MODEL=local-model
# Metal testnet only. Get your RPC endpoint/key from the Metal console.
METAL_RPC_URL=
AGENT_PRIVATE_KEY=
METAL_PROVIDER_URL=
METAL_MAX_PRICE_USD=0.05
METAL_JOB_BUDGET_USD=0.50
