{$OPERATOR_DOMAIN} {
    header Strict-Transport-Security "max-age=31536000"
    request_body {
        max_size 32KB
    }
    # The sandbox merchant remains a separate existing service, without payer secrets.
    redir /merchant https://touchstone-sandbox-merchant.sublimeoak1.chatgpt.site/merchant 302
    reverse_proxy operator:8089 {
        flush_interval -1
        stream_timeout 30s
    }
    # Do not log session cookies, passwords, source bodies or authorization headers.
}
